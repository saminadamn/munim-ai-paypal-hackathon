# Copy to .env.local and fill in. Everything here is for the PayPal sandbox; never put live keys in.

# PayPal sandbox REST app client id (developer.paypal.com > Apps & Credentials > Sandbox).
PAYPAL_CLIENT_ID=
# PayPal sandbox REST app secret, from the same page.
PAYPAL_SECRET=
# Email of the sandbox business account behind the app; PayPal requires invoices to come from it.
MERCHANT_EMAIL=
# Webhook id PayPal shows after you add https://<your-app>/api/webhooks/paypal to the sandbox app.
PAYPAL_WEBHOOK_ID=
# Sandbox personal (buyer) account email; npm run seed sends one invoice here so you can pay it.
SANDBOX_PAYER_EMAIL=

# Postgres connection string for Munim's own tables (profiles, actions, runs, settings, API log).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/munim
# Optional cap on database connections, useful on small hosted databases.
DATABASE_POOL_MAX=

# Optional AG Studio licence key for /dashboard; without it Studio runs with its trial banner.
AG_STUDIO=
# OpenAI key for extraction, collection decisions and the dashboard assistant (wins over OPENAI_API_KEY).
AG_STUDIO_OPENAI_API_KEY=
# Fallback OpenAI key, used only when AG_STUDIO_OPENAI_API_KEY is blank.
OPENAI_API_KEY=
# Comma-separated OpenAI model ids; the first is what Munim uses. Blank means gpt-5.4-mini.
OPENAI_MODELS=

# Currency Munim totals and forecasts in; invoices in other currencies are listed, not converted.
MUNIM_CURRENCY=USD
# Shared secret the hourly cron job sends as the x-munim-key header to POST /api/munim/run.
MUNIM_CRON_KEY=
# Public URL of the deployed app, used only by the Render cron job to reach /api/munim/run.
APP_URL=
